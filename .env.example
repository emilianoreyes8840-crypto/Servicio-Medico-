# Copiar a ".env" en la raiz del proyecto si se quieren cambiar los valores
# por defecto (docker-compose los toma automaticamente si el archivo se
# llama ".env").

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Debe ser EXACTAMENTE igual en auth-service, doctor-service y
# patient-service (ver README, seccion "Correcciones" #3).
JWT_SECRET=aG9zcGl0YWwtbWFuYWdlbWVudC1zeXN0ZW0tYXV0aC1zZXJ2aWNlLWp3dC1zZWNyZXQta2V5LTIwMjYtY2hhbmdlLW1l

# Opcional: credenciales SMTP reales para notification-service
# (por defecto usa el sandbox de Mailtrap, no envia correo real).
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
